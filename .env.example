# ─────────────────────────────────────────────────────────────────────────────
# AEGIS-Flow — Environment Variable Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                  # development | staging | production
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# ── Graph Engine ─────────────────────────────────────────────────────────────
GRAPH_BACKEND=networkx               # networkx | igraph

# ── Taint Engine ─────────────────────────────────────────────────────────────
# Maximum number of hops to trace from a seed node during taint propagation.
TAINT_MAX_HOPS=10
# Minimum taint fraction to continue propagation (flow-conservation cutoff).
TAINT_MIN_FRACTION=0.001

# ── ML Models ────────────────────────────────────────────────────────────────
# Directory where trained model artefacts are stored/loaded.
MODEL_DIR=./backend/models/artefacts
# Random seed for reproducibility across all ML training runs.
RANDOM_SEED=42

# ── Data Paths ───────────────────────────────────────────────────────────────
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
BENCHMARK_DATA_DIR=./data/benchmarks
SYNTHETIC_SEED=42                    # Seed for synthetic data generator

# ── Intervention Engine ───────────────────────────────────────────────────────
# Weighting factors for the intervention utility function.
# utility = ILLICIT_WEIGHT * recovered_illicit - COLLATERAL_WEIGHT * disrupted_legitimate
ILLICIT_WEIGHT=1.0
COLLATERAL_WEIGHT=0.5
# Maximum number of candidate chokepoints evaluated per case.
MAX_CHOKEPOINTS=20

# ── LLM Integration (Optional) ───────────────────────────────────────────────
# The LLM layer is OPTIONAL and used for natural-language explanation ONLY.
# It does NOT influence any provenance, taint, or intervention decision.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
LLM_ENABLED=false                    # Set to true to enable explanation layer

# ── CORS (Frontend) ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
